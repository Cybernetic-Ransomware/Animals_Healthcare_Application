# Local state (deliberate — see versions.tf and ADR-14)
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log

# .terraform.lock.hcl is committed deliberately -- pins provider versions so CI's -lockfile=readonly fails on drift.

# Real variable values — only the .example file is committed
*.tfvars
!terraform.tfvars.example
*.tfvars.json

# Plan output files (may contain resolved secrets)
*.tfplan
tfplan
